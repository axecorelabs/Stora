# Supabase Configuration (single source of truth -- see supabase/migrations/ for schema)
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Public storefront base URL (the apps/store app), used to build each vendor's website link
NEXT_PUBLIC_STORE_URL=https://stora.com.ng

# This app's own base URL (used in emails and the Google OAuth redirect_uri)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Direct Postgres connection (for running migrations in supabase/migrations/)
SUPABASE_DB_URL=postgresql://postgres:your_password@db.your_project_ref.supabase.co:5432/postgres

# Email Configuration
# Default provider is nodemailer via SMTP (set EMAIL_PROVIDER=resend to use Resend instead).
# ZeptoMail SMTP relay: host smtp.zeptomail.com. Use port 465 with secure=true
# (implicit TLS) -- port 587 (STARTTLS) is blocked outbound in some sandboxed/
# restrictive network environments, 465 is not.
EMAIL_PROVIDER=nodemailer
SMTP_HOST=smtp.zeptomail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=emailapikey
SMTP_PASSWORD=your_zeptomail_smtp_token
EMAIL_FROM=Stora <noreply@your-verified-domain>
RESEND_API_KEY=your_resend_api_key

# Cloudflare R2 (S3-compatible) Configuration
# R2 has no per-object ACLs -- public access comes from a custom domain (or the
# r2.dev subdomain) connected to the bucket, which is what R2_PUBLIC_URL should be.
R2_ENDPOINT=https://your_account_id.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=your_bucket_name

# Upstash Redis (REST API) -- rate limiting, session-lookup caching, account lockout.
# Same database is shared by apps/store for its own auth rate limiting.
UPSTASH_REDIS_REST_URL=https://your-db-name.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_rest_token

# Google OAuth ("Sign in with Google") -- separate OAuth client from apps/store,
# since they're different origins with different redirect URIs. Create at
# https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your_dashboard_oauth_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_dashboard_oauth_client_secret

# Better Auth session/cookie signing secret -- generate with
# `node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"`.
# Must be set in every environment including production: Better Auth
# hard-throws in production if this is missing (it silently falls back to a
# public default value in development only, which is why this can go
# unnoticed until deploy). Use a DIFFERENT value from apps/store's --
# they're separate auth domains, sharing one secret would let a forged
# dashboard session/token work against apps/store too.
BETTER_AUTH_SECRET=generate_a_unique_32+_char_random_secret_for_this_app
R2_PUBLIC_URL=https://your-public-domain-or-r2.dev-url

# Paystack -- vendor payout onboarding (bank list, account resolve,
# subaccount creation) and refunds. Same secret key as apps/store (one
# Paystack account, same keypair duplicated across both apps' env files).
PAYSTACK_SECRET_KEY=sk_test_your_paystack_secret_key
# Must match apps/store's PLATFORM_COMMISSION_RATE.
PLATFORM_COMMISSION_RATE=0.10

# QoreID -- vendor NIN + selfie identity verification (dashboard/verification
# page). clientId/secret exchange for a short-lived Bearer token server-side
# (see src/lib/qoreid.js); never exposed to the client. Sandbox credentials
# from your QoreID dashboard work against their documented test NIN
# (63184876213) without touching any real person's data.
QOREID_CLIENT_ID=your_qoreid_client_id
QOREID_CLIENT_SECRET=your_qoreid_client_secret
QOREID_BASE_URL=https://api.qoreid.com

# PostHog browser analytics
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=your_posthog_project_token
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com